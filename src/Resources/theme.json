{
  "name": "Ecomponents Starter",
  "author": "Aggrosoft GmbH",
  "description": {
    "de-DE": "Ein ruhiges, schnelles Fundament für deinen Shopware-Shop.",
    "en-GB": "A clean, lightweight foundation for your Shopware storefront."
  },
  "previewMedia": "preview.svg",
  "views": ["@Storefront", "@Plugins", "@EcomponentsStarterTheme"],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": ["@Storefront"],
  "asset": ["@Storefront"],
  "configInheritance": ["@Storefront"],
  "config": {
    "blocks": {
      "ecStarterLayout": {
        "label": {"de-DE": "Starter: Layout", "en-GB": "Starter: layout"},
        "order": 600
      }
    },
    "fields": {
      "sw-color-brand-primary": {"value": "#c04e0b"},
      "sw-color-brand-secondary": {"value": "#233547"},
      "sw-text-color": {"value": "#293844"},
      "sw-headline-color": {"value": "#172c3d"},
      "sw-border-color": {"value": "#dce1e4"},
      "sw-background-color": {"value": "#ffffff"},
      "sw-color-price": {"value": "#172c3d"},
      "sw-color-buy-button": {"value": "#233547"},
      "sw-color-buy-button-text": {"value": "#ffffff"},
      "sw-font-family-base": {"value": "Arial, Helvetica, sans-serif"},
      "sw-font-family-headline": {"value": "Arial, Helvetica, sans-serif"},
      "ec-starter-radius": {
        "label": {"de-DE": "Eckenradius in Pixeln", "en-GB": "Corner radius in pixels"},
        "helpText": {"de-DE": "Empfohlen: 8 bis 16. Beeinflusst Karten, Eingabefelder und Schaltflächen.", "en-GB": "Recommended: 8 to 16. Applies to cards, inputs and buttons."},
        "type": "number",
        "value": 12,
        "editable": true,
        "block": "ecStarterLayout",
        "order": 100,
        "custom": {"min": 0, "max": 24, "numberType": "int"}
      },
      "ec-starter-content-width": {
        "label": {"de-DE": "Maximale Inhaltsbreite in Pixeln", "en-GB": "Maximum content width in pixels"},
        "type": "number",
        "value": 1320,
        "editable": true,
        "block": "ecStarterLayout",
        "order": 200,
        "custom": {"min": 960, "max": 1680, "numberType": "int"}
      }
    }
  }
}
